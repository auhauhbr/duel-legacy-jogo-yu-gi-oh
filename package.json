{
  "name": "duel-legacy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "pnpm --recursive --if-present run typecheck",
